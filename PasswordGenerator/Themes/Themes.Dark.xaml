<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Same key set as Theme.Light.xaml - every style file references these
       by name via DynamicResource, so whichever of the two dictionaries is
       merged determines the app's appearance. Accent is brightened slightly
       from the light-theme value since the original #0B64F7 reads darker
       and lower-contrast against a dark surface than against white. -->
  <SolidColorBrush x:Key="AccentBrush"               Color="#4C8DFF"/>
  <SolidColorBrush x:Key="SuccessBrush"               Color="#22C55E"/>
  <SolidColorBrush x:Key="AmberBrush"                Color="#E0A930"/>
  <SolidColorBrush x:Key="ControlBorderBrush"                Color="#444444"/>
  <SolidColorBrush x:Key="ControlDisabledBrush"               Color="#3A3A3A"/>
  <SolidColorBrush x:Key="BackgroundGray"             Color="#121212"/>
  <SolidColorBrush x:Key="ControlHoverBrush"                  Color="#333333"/>
  <SolidColorBrush x:Key="ControlPressedBrush"                Color="#3D3D3D"/>
  <SolidColorBrush x:Key="MutedText"                  Color="#AAAAAA"/>
  <SolidColorBrush x:Key="SurfaceBrush"                Color="#1E1E1E"/>
  <SolidColorBrush x:Key="CardBorderBrush"             Color="#3A3A3A"/>
  <SolidColorBrush x:Key="CardHeaderBackgroundBrush"   Color="#262626"/>
  <SolidColorBrush x:Key="PrimaryTextBrush"            Color="#F0F0F0"/>

</ResourceDictionary>
